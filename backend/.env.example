# StudyBuddy Backend Configuration
PORT=5000

# Google Gemma / Gemini API Key
# Get your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMMA_API_KEY=your_google_gemma_api_key_here

# AI Model Selection
# Options: gemma-2-9b-it, gemma-2-27b-it, gemini-1.5-flash
AI_MODEL=gemma-2-9b-it
